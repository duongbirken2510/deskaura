rules_version = '2';

// ===============================================================
// Assumed Data Model — DeskAura Wellness Multi-Device Cloud Sync
// ===============================================================
//
// Collection: /sync_rooms/{syncCode}
// Document ID: syncCode (6..20 chars, e.g., "AURA-892145")
// Allowed Fields:
//   - syncCode: string (matches document ID, immutable on update)
//   - ownerUid: string (set to request.auth.uid on create, immutable on update)
//   - linkedUids: list<string>
//   - connectedDevices: list<map>
//   - updatedAt: number | timestamp
//   - lastDeviceName: string
//   - dailyStats: map
//   - weeklyHistory: list<map>
//   - standupSettings: map
//   - hydrationSettings: map
//   - voiceSettings: map
//
// Collection: /users/{userId}
// Document ID: userId matching request.auth.uid
// Allowed Fields:
//   - updatedAt: number | timestamp
//   - lastDeviceName: string
//   - activeSyncCode: string | null
//   - connectedDevices: list<map>
//   - dailyStats: map
//   - weeklyHistory: list<map>
//   - standupSettings: map
//   - hydrationSettings: map
//   - voiceSettings: map
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSyncRoomData(syncCode) {
      return request.resource.data.keys().hasOnly([
        'syncCode',
        'ownerUid',
        'linkedUids',
        'connectedDevices',
        'updatedAt',
        'lastDeviceName',
        'dailyStats',
        'weeklyHistory',
        'standupSettings',
        'hydrationSettings',
        'voiceSettings'
      ]) &&
      request.resource.data.syncCode == syncCode &&
      syncCode.size() >= 6 &&
      syncCode.size() <= 20;
    }

    function isValidUserWellnessData() {
      return request.resource.data.keys().hasOnly([
        'updatedAt',
        'lastDeviceName',
        'activeSyncCode',
        'connectedDevices',
        'dailyStats',
        'weeklyHistory',
        'standupSettings',
        'hydrationSettings',
        'voiceSettings'
      ]);
    }

    // Multi-device Aura Sync Rooms (/sync_rooms/{syncCode})
    match /sync_rooms/{syncCode} {
      // Exact room lookup allowed for authenticated devices knowing the syncCode
      allow get: if request.auth != null &&
        syncCode.size() >= 6 &&
        syncCode.size() <= 20;

      // Explicitly forbid listing/enumerating sync rooms
      allow list: if false;

      // Creating a sync room requires authentication, valid keys, and creator as ownerUid
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidSyncRoomData(syncCode);

      // Updating a sync room requires authentication, valid keys, and immutable ownerUid/syncCode
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.syncCode == resource.data.syncCode &&
        isValidSyncRoomData(syncCode);

      // Only the original creator/owner of the sync room may delete it
      allow delete: if request.auth != null &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Personal User Cloud Profile (/users/{userId})
    match /users/{userId} {
      allow read, delete: if request.auth != null &&
        request.auth.uid == userId;

      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isValidUserWellnessData();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
