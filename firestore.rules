rules_version = '2';

// ===============================================================
// Assumed Data Model — DeskAura Wellness Multi-Device Cloud Sync
// ===============================================================
//
// Collection: /sync_rooms/{syncCode}
// Document ID: syncCode (lowercase user email address, 5..128 chars, e.g., "duongbirken@gmail.com")
// Allowed Fields:
//   - syncCode: string (matches document ID, immutable on update)
//   - ownerUid: string (set to request.auth.uid on create, immutable on update)
//   - linkedUids: list<string>
//   - connectedDevices: list<map>
//   - updatedAt: number | timestamp
//   - lastDeviceName: string
//   - dailyStats: map
//   - weeklyHistory: list<map>
//   - standupSettings: map
//   - hydrationSettings: map
//   - voiceSettings: map
//
// Collection: /users/{userId}
// Document ID: userId matching request.auth.uid
// Allowed Fields:
//   - updatedAt: number | timestamp
//   - lastDeviceName: string
//   - activeSyncCode: string | null
//   - connectedDevices: list<map>
//   - dailyStats: map
//   - weeklyHistory: list<map>
//   - standupSettings: map
//   - hydrationSettings: map
//   - voiceSettings: map
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSyncRoomEmailOwner(syncCode) {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == syncCode &&
        syncCode.size() >= 5 &&
        syncCode.size() <= 128;
    }

    function isValidSyncRoomData(syncCode) {
      return request.resource.data.keys().hasOnly([
        'syncCode',
        'ownerUid',
        'linkedUids',
        'connectedDevices',
        'updatedAt',
        'lastDeviceName',
        'dailyStats',
        'weeklyHistory',
        'standupSettings',
        'hydrationSettings',
        'voiceSettings'
      ]) &&
      request.resource.data.syncCode is string &&
      request.resource.data.syncCode == syncCode &&
      syncCode.size() >= 5 &&
      syncCode.size() <= 128;
    }

    function isValidUserWellnessData() {
      return request.resource.data.keys().hasOnly([
        'updatedAt',
        'lastDeviceName',
        'activeSyncCode',
        'connectedDevices',
        'dailyStats',
        'weeklyHistory',
        'standupSettings',
        'hydrationSettings',
        'voiceSettings'
      ]);
    }

    // Multi-device Aura Sync Rooms keyed by lowercase email (/sync_rooms/{syncCode})
    match /sync_rooms/{syncCode} {
      // Exact room lookup allowed only for the authenticated owner of this email address
      allow get: if isSyncRoomEmailOwner(syncCode);

      // Explicitly forbid listing/enumerating sync rooms
      allow list: if false;

      // Creating a sync room requires matching authenticated email, valid keys, and creator as ownerUid
      allow create: if isSyncRoomEmailOwner(syncCode) &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidSyncRoomData(syncCode);

      // Updating a sync room requires matching authenticated email, valid keys, and immutable ownerUid/syncCode
      allow update: if isSyncRoomEmailOwner(syncCode) &&
        (!('ownerUid' in resource.data) || request.resource.data.ownerUid == resource.data.ownerUid) &&
        (!('syncCode' in resource.data) || request.resource.data.syncCode == resource.data.syncCode) &&
        isValidSyncRoomData(syncCode);

      // Only the authenticated owner of the email room may delete it
      allow delete: if isSyncRoomEmailOwner(syncCode) &&
        (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid);
    }

    // Personal User Cloud Profile (/users/{userId})
    match /users/{userId} {
      allow read, delete: if request.auth != null &&
        request.auth.uid == userId;

      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isValidUserWellnessData();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
