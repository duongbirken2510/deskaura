{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskAura",
  "version": "1.2.3",
  "identifier": "com.deskaura.officewellness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskAura — Trợ Lý Sức Khỏe & Nhạc Nền Văn Phòng",
        "width": 1120,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

